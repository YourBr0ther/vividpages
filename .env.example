# Postgres (matches docker-compose defaults)
DATABASE_URL=postgres://vividpages:vividpages@localhost:5432/vividpages

# Redis (BullMQ queues)
REDIS_URL=redis://localhost:6379

# MinIO object storage (matches docker-compose defaults)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=vividpages
MINIO_SECRET_KEY=vividpages123

# AI endpoints (separate machine)
OLLAMA_URL=http://10.0.2.192:11434
COMFYUI_URL=http://10.0.2.192:8000

# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# API key encryption (AES-256-GCM), 64 hex chars — generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
